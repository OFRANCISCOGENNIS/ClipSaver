    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
