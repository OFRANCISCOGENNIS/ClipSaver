# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Report emitted by `flutter gen-l10n`: an empty object is the expected
# state, and the l10n test asserts key parity anyway.
/l10n-untranslated.json

# Web runtime binaries fetched by tool/fetch_web_assets.sh — build
# artifacts pinned by version there, not source.
/web/sqlite3.wasm
/web/drift_worker.js

# Release signing material. Kept out of the repository on purpose; CI
# writes it from secrets (see .github/workflows/release.yml).
/android/key.properties
/android/*.jks
/android/*.keystore

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
